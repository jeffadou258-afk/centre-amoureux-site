# Adresse publique du site (liens absolus, aperçus de partage, plan du site).
NEXT_PUBLIC_SITE_URL=https://jeffadou258-afk.github.io/centre-amoureux-site

# API de Hermes (serveur uniquement). Vide = aucun envoi en ligne :
# les formulaires l'annoncent honnêtement et proposent WhatsApp.
CAD_API_URL=

# Secret partagé avec Hermes pour /api/revalidate (serveur à serveur).
